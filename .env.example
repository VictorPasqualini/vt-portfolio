# Copy to .env.local for local runs, or set these in the deploy environment.
# All of them are read at build time (NEXT_PUBLIC_* values are inlined), so a
# change only takes effect after a rebuild.

# Absolute origin the site is served from. Used for canonical URLs, hreflang
# alternates, Open Graph tags and sitemap.xml. Falls back to the Netlify
# subdomain when unset — set it to the real domain once it exists.
NEXT_PUBLIC_SITE_URL=https://example.com

# Analytics is opt-in: with NEXT_PUBLIC_ANALYTICS_SRC unset, no third-party
# script is loaded at all. Fill in the pair that matches your provider.
#
# Umami (cloud or self-hosted):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
#   NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=<website id from the Umami dashboard>
#
# Plausible (cloud or self-hosted):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=<the domain registered in Plausible>
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
